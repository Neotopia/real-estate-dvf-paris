# ============================================================
# Environment configuration template
# ============================================================
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# ".env" is git-ignored — it never gets committed, so your project id
# and any personal settings stay local to your machine.
# ============================================================

# Required: your Google Cloud / BigQuery Sandbox project id.
# Find it at https://console.cloud.google.com (the "Project ID", not
# the display name). Also used by dbt (see dbt/profiles.yml.example).
BQ_PROJECT_ID=

# Optional overrides — uncomment and edit if you want something other
# than the defaults used by scripts/download_and_load.py.
# BQ_DATASET=dvf_immobilier
# BQ_RAW_TABLE=raw_mutations_idf
# BQ_LOCATION=EU

# DVF_YEARS: geo-DVF only publishes a rolling window of the last ~5
# completed years, so if left unset the script computes this automatically
# (see default_years() in download_and_load.py). Only set this if you want
# a different range, or a single year for an incremental/manual run:
# DVF_YEARS=2024
# DVF_YEARS=2021 2022 2023 2024 2025

# DVF_DEPARTMENTS=75 92 93 94
